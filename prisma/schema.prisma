generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────── AUTH ───────────────────────────────

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?      @db.Text
  role          String       @default("VIEWER")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  templates     Template[]
  newsletters   Newsletter[]
  auditLogs     AuditLog[]
    privacyEvents PrivacyEvent[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}



model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        String    @default("VIEWER")
  token       String    @unique
  status      String    @default("PENDING")
  invitedById String?
  expiresAt   DateTime
  claimedAt   DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

// ─────────────────────────────── CMS ────────────────────────────────

enum MemberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

model ChurchSettings {
  id            String   @id @default("default")
  name          String   @default("Glory Worship Church")
  email         String?
  phone         String?
  website       String?
  logoUrl       String?  @db.Text
  primaryColor  String   @default("#1B2A4A")
  accentColor   String   @default("#F6C84C")

  // Address
  address       String?  @db.Text
  addressLine1  String?
  addressLine2  String?
  city          String?
  stateProvince String?
  postalCode    String?
  country       String?

  // Regional
  timezone      String   @default("UTC")
  language      String   @default("en-US")

  // Email sending
  senderName    String?
  senderEmail   String?
  replyTo       String?
  footerText    String?  @db.Text
  unsubscribeText String?  @db.Text
  alertRecipients String?  @db.Text
  alertOnSuccess  Boolean  @default(true)
  alertOnFailure  Boolean  @default(true)
  defaultTestSend Boolean  @default(true)

  updatedAt     DateTime @updatedAt
}
model Member {
  id               String        @id @default(cuid())
  memberNumber     Int           @unique
  name             String
  email            String        @unique
  phone            String?
  membershipStatus String        @default("active")
  membershipType   String?
  gender           String?
  dateOfBirth      DateTime?
  streetAddress    String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  joinDate         DateTime?
  renewalDate      DateTime?
  status           MemberStatus  @default(SUBSCRIBED)
  source           String?
  consentAt        DateTime?
  consentSource    String?
  unsubscribedAt   DateTime?
  unsubscribeToken String        @unique @default(cuid())
  notes            String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  groups           MemberGroup[]
  deliveries       Delivery[]
   privacyEvents PrivacyEvent[]

  @@index([status])
  @@index([membershipStatus])
}

model PrivacyEvent {
  id        String   @id @default(cuid())
  memberId  String
  actorId   String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([memberId, createdAt])
}

model Group {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?           @db.Text
  color       String?
  createdAt   DateTime          @default(now())
  members     MemberGroup[]
  newsletters NewsletterGroup[]
}

model MemberGroup {
  memberId String
  groupId  String
  addedAt  DateTime @default(now())
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([memberId, groupId])
  @@index([groupId])
}

model Template {
  id           String       @id @default(cuid())
  name         String
  description  String?      @db.Text
  category     String       @default("General")
  thumbnailUrl String?      @db.VarChar(1000)
  isPopular    Boolean      @default(false)
  design       Json?
  html         String?      @db.LongText
  isDefault    Boolean      @default(false)
  createdById  String?
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  newsletters  Newsletter[]
}


model Newsletter {
  id             String            @id @default(cuid())
  title          String
  subject        String
  previewText    String?
  content        Json?
  html           String?           @db.LongText
  status         NewsletterStatus  @default(DRAFT)
  category       String?
  sendToAll      Boolean           @default(true)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int               @default(0)
  sentCount      Int               @default(0)
  failedCount    Int               @default(0)
  openCount      Int               @default(0)
  clickCount     Int               @default(0)
  templateId     String?
  template       Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  authorId       String?
  author         User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  groups         NewsletterGroup[]
  deliveries     Delivery[]

  @@index([status])
  @@index([scheduledAt])
  @@index([category])
}

model NewsletterGroup {
  newsletterId String
  groupId      String
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([newsletterId, groupId])
}

model Delivery {
  id           String         @id @default(cuid())
  newsletterId String
  memberId     String?
  email        String
  status       DeliveryStatus @default(QUEUED)
  error        String?        @db.Text
  trackingId   String         @unique @default(cuid())
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  createdAt    DateTime       @default(now())
  newsletter   Newsletter     @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  member       Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([newsletterId, email])
  @@index([newsletterId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}


model EmailProvider {
  id            String    @id @default(cuid())
  name          String
  preset        String    @default("custom")
  host          String
  port          Int       @default(587)
  secure        Boolean   @default(false)
  username      String
  passwordEnc   String    @db.Text
  isActive      Boolean   @default(false)

  maxPerHour    Int?
  maxPerDay     Int?
  batchSize     Int       @default(50)
  batchDelaySec Int       @default(60)

  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  lastError     String?   @db.Text

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive])
}